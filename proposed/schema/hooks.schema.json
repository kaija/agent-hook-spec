{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kaija/agent-hook-spec/main/proposed/schema/hooks.schema.json",
  "title": "Proposed Claude Code–Based Hook Extensions",
  "description": "Claude Code hook JSON extended with distributed tracing, content identity, and receiver metadata.",
  "oneOf": [
    { "$ref": "#/$defs/ExtendedRequest" },
    { "$ref": "#/$defs/ExtendedResponse" }
  ],
  "$defs": {
    "ExtendedRequest": {
      "allOf": [
        { "$ref": "https://agent-hook-spec.local/schemas/claude-code-hooks.schema.json" },
        {
          "not": { "required": ["metadata"] },
          "properties": {
            "trace_id": {
              "type": "string",
              "description": "Distributed trace identifier propagated across hook deliveries."
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$",
              "description": "SHA-256 digest of the RFC 8785 canonicalized request object after removing content_hash."
            }
          }
        }
      ]
    },
    "ExtendedResponse": {
      "allOf": [
        { "$ref": "https://agent-hook-spec.local/schemas/claude-code-hooks.schema.json#/$defs/ResponseBase" },
        { "not": { "required": ["hook_event_name"] } },
        { "not": { "required": ["trace_id"] } },
        { "not": { "required": ["content_hash"] } },
        {
          "properties": {
            "metadata": { "$ref": "#/$defs/ResponseMetadata" }
          }
        }
      ]
    },
    "ResponseMetadata": {
      "type": "object",
      "description": "Supplemental receiver processing information with no decision semantics.",
      "additionalProperties": true,
      "properties": {
        "latencyMs": { "type": "number", "minimum": 0 },
        "triggeredRules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "auditId": { "type": "string" }
      }
    }
  }
}
